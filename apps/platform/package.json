{
	"name": "@pina-rs/lootbox-platform",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "react-router dev --host 127.0.0.1",
		"build": "react-router build",
		"preview": "pnpm build && vite preview --host 127.0.0.1",
		"typegen": "wrangler types --strict-vars=false && react-router typegen",
		"check": "pnpm typegen && tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "env -u NO_COLOR playwright test",
		"db:migrate:local": "wrangler d1 migrations apply lootbox --local",
		"deploy": "react-router build && wrangler deploy"
	},
	"dependencies": {
		"@cf-wasm/og": "0.5.0",
		"@fontsource-variable/nunito": "^5.2.7",
		"@fontsource/bungee": "^5.3.0",
		"@pina-rs/lootbox": "workspace:*",
		"@solana-program/token-2022": "0.19.0",
		"@solana/kit": "^8.3.0",
		"@solana/react": "8.3.0",
		"@solana/wallet-standard-features": "^1.5.0",
		"@wallet-standard/app": "^1.1.1",
		"@wallet-standard/base": "^1.1.1",
		"@wallet-standard/features": "^1.1.1",
		"@wallet-standard/react": "^1.0.3",
		"isbot": "^5.2.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "7.18.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@cloudflare/vite-plugin": "1.60.2",
		"@playwright/test": "^1.63.0",
		"@react-router/dev": "7.18.4",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.2",
		"wrangler": "4.141.0"
	}
}
