/**
 * lootbox.pina.rs Worker configuration.
 *
 * Local development runs entirely in Miniflare (`pnpm dev`), with `.dev.vars`
 * overriding the vars below. `platform.yml` deploys it from main once the
 * Cloudflare account is connected. Replace the placeholder D1 `database_id`
 * with the id printed by `wrangler d1 create lootbox` before the first deploy.
 * See README.md for the full checklist.
 */
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lootbox-platform",
	"main": "./workers/app.ts",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	// Requires the pina.rs zone in the same Cloudflare account.
	"routes": [{ "pattern": "lootbox.pina.rs", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lootbox",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "lootbox-media"
		}
	],
	"triggers": {
		// The settlement relayer finishes abandoned openings every minute.
		"crons": ["* * * * *"]
	},
	"vars": {
		// Canonical public origin, written into on-chain metadata URIs. Empty means
		// "the request's own origin"; .dev.vars.example empties it for local runs.
		"PUBLIC_ORIGIN": "https://lootbox.pina.rs",
		"DEFAULT_CLUSTER": "devnet",
		// Comma-separated clusters creators may choose: devnet, mainnet, localnet.
		"ENABLED_CLUSTERS": "devnet",
		"RPC_URL_DEVNET": "https://api.devnet.solana.com",
		"RPC_URL_MAINNET": "",
		// Loopback Surfpool control plane (`pnpm playground:rpc`); localnet only.
		"LOCALNET_CONTROL_URL": "",
		// Clusters the cron relayer serves. Keep mainnet out until audited.
		"RELAYER_CLUSTERS": "devnet",
		// Also deliver allocated prizes (the relayer then pays token-account rent).
		"RELAYER_CLAIM": "false",
		// Exclusive Lootbox NFTs; enable once the SDK ships them.
		"FEATURE_EXCLUSIVE_NFTS": "false",
		// NFT prizes from other projects in the bundle builder.
		"FEATURE_NFT_PRIZES": "false",
		// Selling boxes on a bonding curve. A paid chance at a prize is a lottery
		// in many places (the UK included); enable only where that is lawful.
		"FEATURE_BOX_CURVES": "false",
		// The Introductory Exclusive Lootbox NFT collection PDA per cluster,
		// printed by `pnpm exclusive:collection -- --execute`.
		"EXCLUSIVE_COLLECTION_DEVNET": "",
		"EXCLUSIVE_COLLECTION_MAINNET": ""
	}
}
